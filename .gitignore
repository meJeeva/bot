# ---------------------------------------------------------------------------
# MT5 Market Data - things that must never be committed
# ---------------------------------------------------------------------------

# --- Secrets / local configuration ----------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
secrets/

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
ENV/
.python-version
*.egg-info/
.eggs/
build/
dist/
pip-wheel-metadata/

# --- Test / tooling caches -------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- Local databases -------------------------------------------------------
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
backend/data/

# --- Node / frontend -------------------------------------------------------
node_modules/
frontend/dist/
frontend/.vite/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- MetaTrader local artefacts -------------------------------------------
