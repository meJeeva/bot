"""Strategy API endpoints for Phase 2.

These endpoints expose the deterministic Fibonacci strategy engine's state over
REST. They are strictly read-only: the engine analyses genuine MT5 candle data
and reports setup state, but never submits, modifies or closes an order.

``CONFIRMED_BUY`` / ``CONFIRMED_SELL`` are strategy conditions only.

Every payload is validated by a Pydantic schema from :mod:`app.schemas.strategy`,
so a contract change is caught at the boundary rather than reaching the
dashboard. When MT5 data is unavailable or no valid setup exists, the endpoints
report that honestly (``data_available: false`` / ``setup: null``) instead of
inventing prices or signals.
"""

from __future__ import annotations

import json
from datetime import datetime, timezone
from typing import Optional

from fastapi import APIRouter, Depends, Query, Request

from ..config import Settings, get_settings
from ..errors import ApiError
from ..strategy.coordinator import StrategyCoordinator
from ..mt5.timeframes import TIMEFRAME_ORDER, normalize_timeframe
from ..schemas.strategy import (
    ConfirmationOut,
    EntryZoneOut,
    FibonacciLevelsOut,
    ForwardObservationOut,
    ForwardObservationsOut,
    ForwardReportOut,
    ForwardStatusOut,
    InvalidationOut,
    ShadowObservationOut,
    ShadowObservationsOut,
    ShadowReportOut,
    ShadowStatusOut,
    StateTransitionOut,
    StrategySetupsOut,
    StrategySetupOut,
    StrategyStatusOut,
    SwingPointOut,
    TimeframeStrategyOut,
)
from ..services.market_monitor import MarketMonitor
from ..strategy.engine import StrategyEngine, TimeframeState
from ..strategy.shadow import SHADOW_SCENARIOS
from ..strategy.setup import FibonacciSetup

router = APIRouter(prefix="/strategy", tags=["strategy"])

# ----------------------------------------------------------------------
# Dependencies
# ----------------------------------------------------------------------


def get_strategy_engine(request: Request) -> StrategyEngine:
    engine = getattr(request.app.state, "strategy_engine", None)
    if engine is None:
        raise ApiError(
            "strategy_engine_not_initialized",
            "Strategy engine is not initialized",
            status_code=503,
        )
    return engine


def get_strategy_coordinator(request: Request) -> StrategyCoordinator:
    coordinator = getattr(request.app.state, "strategy_coordinator", None)
    if coordinator is None:
        raise ApiError(
            "strategy_coordinator_not_initialized",
            "Strategy coordinator is not initialized",
            status_code=503,
        )
    return coordinator


def get_market_monitor(request: Request) -> MarketMonitor:
    monitor = getattr(request.app.state, "monitor", None)
    if monitor is None:
        raise ApiError(
            "market_monitor_not_initialized",
            "Market monitor is not initialized",
            status_code=503,
        )
    return monitor


# ----------------------------------------------------------------------
# Fibonacci strategy endpoints
# ----------------------------------------------------------------------


@router.get(
    "/status",
    response_model=StrategyStatusOut,
    summary="Strategy engine status",
)
async def strategy_status(
    engine: StrategyEngine = Depends(get_strategy_engine),
    settings: Settings = Depends(get_settings),
) -> StrategyStatusOut:
    """Return whether the strategy engine is running and its latest error."""
    if not engine.running:
        return StrategyStatusOut(
            running=False,
            read_only=True,
            trading_enabled=False,
            symbol=settings.mt5_symbol,
            supported_timeframes=list(TIMEFRAME_ORDER),
            total_evaluations=0,
            last_error="Strategy engine is not running",
            timeframes={},
        )
    statuses: dict[str, TimeframeStrategyOut] = {}
    for name, tf_state in engine.timeframe_states().items():
        statuses[name] = _timeframe_out(tf_state)
    return StrategyStatusOut(
        running=True,
        read_only=True,
        trading_enabled=False,
        symbol=settings.mt5_symbol,
        supported_timeframes=list(TIMEFRAME_ORDER),
        total_evaluations=engine.total_evaluations,
        last_error=engine.last_error,
        timeframes=statuses,
    )


@router.get(
    "/fibonacci",
    response_model=TimeframeStrategyOut,
    summary="Fibonacci levels and setup for a timeframe",
)
async def strategy_fibonacci(
    timeframe: str = Query(default="M15", description="One of M1, M5, M15, M30, H1, H4, D1"),
    engine: StrategyEngine = Depends(get_strategy_engine),
) -> TimeframeStrategyOut:
    """Return the active swing, Fibonacci levels, entry zone and setup state."""
    try:
        name = normalize_timeframe(timeframe)
    except Exception as exc:
        raise ApiError(
            "unsupported_timeframe",
            str(exc),
            status_code=400,
            detail={"supported": list(TIMEFRAME_ORDER)},
        ) from exc

    tf_state = engine.get_timeframe_state(name)
    if tf_state is None:  # pragma: no cover - defensive, normalize guarantees this
        raise ApiError(
            "unsupported_timeframe",
            f"Unsupported timeframe: {timeframe}",
            status_code=400,
            detail={"supported": list(TIMEFRAME_ORDER)},
        )
    return _timeframe_out(tf_state)


def _timeframe_out(tf_state: TimeframeState) -> TimeframeStrategyOut:
    """Convert a TimeframeState to a TimeframeStrategyOut."""
    setup = tf_state.setup
    return TimeframeStrategyOut(
        timeframe=tf_state.timeframe,
        data_available=tf_state.data_available,
        last_error=tf_state.last_error,
        last_evaluated_candle_time=tf_state.last_evaluated_candle_time,
        last_evaluated_candle_utc=tf_state.last_evaluated_candle_utc.isoformat()
        if tf_state.last_evaluated_candle_utc
        else None,
        latest_confirmed_swing=_swing_out(tf_state.latest_confirmed_swing),
        setup=_setup_out(setup) if setup else None,
    )


def _swing_out(swing: Optional[SwingPoint]) -> Optional[SwingPointOut]:
    if swing is None:
        return None
    return SwingPointOut(
        type=swing.swing_type.value,
        price=swing.price,
        time=swing.candle_time,
        time_utc=swing.candle_time_utc.isoformat(),
        confirmation_time_utc=swing.confirmation_timestamp.isoformat()
        if swing.confirmation_timestamp
        else None,
        timeframe=swing.timeframe,
    )


def _setup_out(setup: Optional[FibonacciSetup]) -> Optional[StrategySetupOut]:
    if setup is None:
        return None
    return StrategySetupOut(
        setup_id=setup.setup_id,
        direction=setup.direction.value,
        state=setup.state.value,
        state_reason=setup.status_reason,
        zone_lower=setup.zone_lower,
        zone_upper=setup.zone_upper,
        primary_level_price=setup.primary_level_price,
        invalidation_boundary=setup.get_invalidation_boundary(),
        candles_since_creation=setup.candles_since_creation,
        candles_in_zone=setup.candles_in_zone,
        created_at=setup.created_at.isoformat(),
        confirmation=_confirmation_out(setup.confirmation_detail)
        if setup.confirmation_detail
        else None,
        invalidation=_invalidation_out(setup.invalidation_reason, setup.invalidation_price, setup.invalidation_candle_time)
        if setup.invalidation_reason
        else None,
    )


def _confirmation_out(detail: Optional[ConfirmationDetail]) -> Optional[ConfirmationOut]:
    if detail is None:
        return None
    return ConfirmationOut(
        reason=detail.reason.value,
        candle_time=detail.candle_time,
        candle_time_utc=detail.candle_time_utc.isoformat(),
        candle_open=detail.candle_open,
        candle_high=detail.candle_high,
        candle_low=detail.candle_low,
        candle_close=detail.candle_close,
        wick_ratio=detail.wick_ratio,
        body_ratio=detail.body_ratio,
    )


def _invalidation_out(
    reason: Optional[InvalidationReason],
    price: Optional[float],
    candle_time: Optional[int],
) -> Optional[InvalidationOut]:
    if reason is None:
        return None
    return InvalidationOut(
        reason=reason.value,
        price=price,
        candle_time=candle_time,
    )


@router.get(
    "/setups",
    response_model=StrategySetupsOut,
    summary="All setups across the seven timeframes",
)
async def strategy_setups(
    engine: StrategyEngine = Depends(get_strategy_engine),
) -> StrategySetupsOut:
    """Return every current setup (active and terminal) across all timeframes."""
    setups = [
        _setup_out(setup)
        for setup in engine.get_all_setups()
    ]
    return StrategySetupsOut(count=len(setups), setups=setups)


@router.get(
    "/setups/recent",
    response_model=StrategySetupsOut,
    summary="Most recent setups across all timeframes",
)
async def strategy_setups_recent(
    limit: int = Query(default=20, ge=1, le=100),
    engine: StrategyEngine = Depends(get_strategy_engine),
) -> StrategySetupsOut:
    """Return the most recent setups across all timeframes."""
    setups = [_setup_out(setup) for setup in engine.get_recent_strategy_setups(limit)]
    return StrategySetupsOut(count=len(setups), setups=setups)


@router.get(
    "/setups/{setup_id}",
    response_model=StrategySetupOut,
    summary="Get a setup by its identifier",
)
async def strategy_setup_by_id(
    setup_id: str,
    engine: StrategyEngine = Depends(get_strategy_engine),
) -> StrategySetupOut:
    """Return a specific setup by its identifier."""
    setup = engine.get_setup_by_id(setup_id)
    if setup is None:
        raise ApiError(
            "setup_not_found",
            f"Setup {setup_id!r} not found",
            status_code=404,
        )
    return _setup_out(setup)


