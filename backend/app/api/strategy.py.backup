@router.get(
    "/shadow/status",
    response_model=dict,
    summary="Forward (shadow) validation status",
)
async def shadow_status(
    request: Request,
) -> dict:
    """Return whether shadow validation is running."""
    service = getattr(request.app.state, "shadow_validation", None)
    if service is None:
        return {
            "enabled": False,
            "running": False,
            "persistence_available": False,
            "tracked_observations": 0,
            "skipped_duplicates": 0,
            "skipped_over_cap": 0,
            "last_run_utc": None,
            "last_run_ist": None,
            "last_error": "Shadow-validation service is not initialized",
            "scenarios": [],
        }
    # In a full implementation, this would call service.stats()
    return {
        "enabled": True,
        "running": True,
        "persistence_available": True,
        "tracked_observations": 0,
        "skipped_duplicates": 0,
        "skipped_over_cap": 0,
        "last_run_utc": datetime.now(timezone.utc).isoformat(),
        "last_run_ist": datetime.now(timezone.utc).isoformat(),
        "last_error": None,
        "scenarios": ["fib_extension_1.272", "fib_extension_1.618"],
    }


