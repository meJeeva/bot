"""Minimal SQLite persistence for Phase 1 status, market-data telemetry, and Phase 2 strategy state.

Phase 1 does not need a trading database. It does need a durable record of when
the MT5 connection changed state and what the market data looked like, so the
dashboard can show recent connection errors after a backend restart.

Phase 2 adds persistence for Fibonacci strategy setups and state transitions,
so a restart doesn't silently create duplicate active setups.

The store is deliberately small, synchronous and failure-tolerant: a database
problem must never take down the market-data monitor. Callers wrap the blocking
methods with :func:`asyncio.to_thread`.
"""

from __future__ import annotations

import json
import sqlite3
import threading
from dataclasses import dataclass
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

from .logging_config import get_logger
from .schemas.market import Quote
from .schemas.status import MT5Status

logger = get_logger(__name__)

_SCHEMA = """
CREATE TABLE IF NOT EXISTS connection_events (
    id              INTEGER PRIMARY KEY AUTOINCREMENT,
    timestamp       TEXT    NOT NULL,
    state           TEXT    NOT NULL,
    initialized     INTEGER NOT NULL,
    connected       INTEGER NOT NULL,
    account_type    TEXT,
    symbol          TEXT,
    error           TEXT
);

CREATE TABLE IF NOT EXISTS market_snapshots (
    id              INTEGER PRIMARY KEY AUTOINCREMENT,
    timestamp       TEXT    NOT NULL,
    symbol          TEXT    NOT NULL,
    bid             REAL,
    ask             REAL,
    spread_points   REAL,
    freshness       TEXT    NOT NULL,
    age_seconds     REAL,
    received_at     TEXT
);

-- Phase 2: Strategy state persistence
CREATE TABLE IF NOT EXISTS strategy_setups (
    id                      TEXT    PRIMARY KEY,
    symbol                  TEXT    NOT NULL,
    timeframe               TEXT    NOT NULL,
    direction               TEXT    NOT NULL,
    state                   TEXT    NOT NULL,
    swing_high_price        REAL,
    swing_high_time         INTEGER,
    swing_high_time_utc     TEXT,
    swing_low_price         REAL,
    swing_low_time          INTEGER,
    swing_low_time_utc      TEXT,
    fib_levels_json         TEXT,
    zone_lower              REAL,
    zone_upper              REAL,
    primary_level_price     REAL,
    invalidation_reason     TEXT,
    invalidation_price      REAL,
    invalidation_candle_time INTEGER,
    invalidation_candle_utc  TEXT,
    confirmation_json       TEXT,
    created_at              TEXT    NOT NULL,
    last_evaluated_candle_time INTEGER,
    last_evaluated_candle_utc TEXT,
    candles_since_creation  INTEGER,
    candles_in_zone         INTEGER,
    config_json             TEXT
);

CREATE TABLE IF NOT EXISTS strategy_state_transitions (
    id              INTEGER PRIMARY KEY AUTOINCREMENT,
    setup_id        TEXT    NOT NULL,
    from_state      TEXT    NOT NULL,
    to_state        TEXT    NOT NULL,
    timestamp       TEXT    NOT NULL,
    reason          TEXT    NOT NULL,
    candle_time     INTEGER,
    FOREIGN KEY(setup_id) REFERENCES strategy_setups(id)
);

CREATE INDEX IF NOT EXISTS idx_connection_events_timestamp
    ON connection_events (timestamp DESC);
CREATE INDEX IF NOT EXISTS idx_market_snapshots_timestamp
    ON market_snapshots (timestamp DESC);
CREATE INDEX IF NOT EXISTS idx_strategy_setups_symbol_tf
    ON strategy_setups (symbol, timeframe);
CREATE INDEX IF NOT EXISTS idx_strategy_transitions_setup
    ON strategy_state_transitions (setup_id, timestamp);

-- Phase 4: durable demo-execution records. The unique idempotency key is the
-- database-level backstop against duplicate orders for one strategy setup.
-- Account identity is stored masked only; no secrets ever reach this table.
CREATE TABLE IF NOT EXISTS executions (
    id                      TEXT    PRIMARY KEY,
    idempotency_key         TEXT    NOT NULL UNIQUE,
    setup_id                TEXT    NOT NULL,
    symbol                  TEXT    NOT NULL,
    timeframe               TEXT    NOT NULL,
    direction               TEXT    NOT NULL,
    source                  TEXT    NOT NULL DEFAULT 'live_strategy',
    signal_time_utc         TEXT,
    confirmation_time_utc   TEXT,
    config_fingerprint      TEXT,
    account_login_masked    TEXT,
    account_server          TEXT,
    requested_volume        REAL,
    actual_volume           REAL,
    entry_price             REAL,
    stop_loss               REAL,
    take_profit             REAL,
    risk_budget             REAL,
    estimated_loss          REAL,
    assessment_json         TEXT,
    state                   TEXT    NOT NULL,
    stage                   TEXT,
    broker_retcode          INTEGER,
    broker_order_id         INTEGER,
    broker_deal_id          INTEGER,
    position_id             INTEGER,
    fill_price              REAL,
    error_code              TEXT,
    error_message           TEXT,
    reconciliation          TEXT,
    created_at              TEXT    NOT NULL,
    updated_at              TEXT    NOT NULL
);
CREATE UNIQUE INDEX IF NOT EXISTS idx_executions_idempotency
    ON executions (idempotency_key);
CREATE INDEX IF NOT EXISTS idx_executions_created
    ON executions (created_at DESC);

-- Phase 4: persistent risk state. Daily baselines and lockouts must survive
-- restarts; losing them would reset protections.
CREATE TABLE IF NOT EXISTS execution_risk_state (
    key                     TEXT    PRIMARY KEY,
    risk_date               TEXT,
    baseline_equity         REAL,
    baseline_balance        REAL,
    high_water_equity       REAL,
    lockout_reason          TEXT,
    lockout_at              TEXT,
    consecutive_losses      INTEGER,
    last_reconciled_at      TEXT,
    updated_at              TEXT    NOT NULL
);

-- Forward (shadow) validation: read-only observations of the live strategy
-- engine's confirmed setups and their hypothetical Fibonacci-extension
-- outcomes. Nothing here is a real order or fill. The UNIQUE (setup_id,
-- scenario) constraint is the database-level backstop against processing the
-- same setup twice after a WebSocket reconnect or an application restart.
CREATE TABLE IF NOT EXISTS shadow_observations (
    id                          TEXT    PRIMARY KEY,
    setup_id                    TEXT    NOT NULL,
    scenario                    TEXT    NOT NULL,
    source                      TEXT    NOT NULL,
    symbol                      TEXT    NOT NULL,
    timeframe                   TEXT    NOT NULL,
    direction                   TEXT    NOT NULL,
    confirmation_candle_time    INTEGER,
    confirmation_time_utc       TEXT,
    confirmation_time_ist       TEXT,
    proposed_entry              REAL,
    stop_loss                   REAL,
    target                      REAL,
    extension_ratio             REAL,
    fib_extension_json          TEXT,
    status                      TEXT    NOT NULL,
    hit_candle_time             INTEGER,
    hit_time_utc                TEXT,
    hit_time_ist                TEXT,
    hit_price                   REAL,
    holding_candles             INTEGER NOT NULL DEFAULT 0,
    last_evaluated_candle_time  INTEGER,
    outcome_basis               TEXT,
    entry_assumption            TEXT,
    measured_json               TEXT,
    assumptions_json            TEXT,
    gross_points                REAL,
    net_points                  REAL,
    cost_points                 REAL,
    data_note                   TEXT,
    created_at                  TEXT    NOT NULL,
    created_at_ist              TEXT,
    updated_at                  TEXT    NOT NULL,
    updated_at_ist              TEXT,
    UNIQUE (setup_id, scenario)
);
CREATE INDEX IF NOT EXISTS idx_shadow_status
    ON shadow_observations (status);
CREATE INDEX IF NOT EXISTS idx_shadow_setup
    ON shadow_observations (setup_id);
CREATE INDEX IF NOT EXISTS idx_shadow_timeframe
    ON shadow_observations (timeframe);
"""


@dataclass
class StoreStats:
    """Cheap diagnostics for the status endpoint."""

    enabled: bool
    path: str | None
    connection_events: int = 0
    market_snapshots: int = 0
    last_error: str | None = None
    active_strategy_setups: int = 0
    strategy_transitions: int = 0


class StoreWriteError(RuntimeError):
    """A required durable write failed (Phase 4 execution must fail closed)."""


class StoreConflictError(StoreWriteError):
    """A uniqueness constraint refused the write (duplicate idempotency key)."""


class StatusStore:
    """Thread-safe SQLite store for connection events and market snapshots."""

    def __init__(self, path: Path, *, enabled: bool = True) -> None:
        self._path = Path(path)
        self._enabled = enabled
        self._lock = threading.RLock()
        self._connection: sqlite3.Connection | None = None
        self._last_error: str | None = None
        self._failures = 0
        self._last_event_key: tuple[Any, ...] | None = None

    # ------------------------------------------------------------------
    @property
    def enabled(self) -> bool:
        return self._enabled and self._connection is not None

    @property
    def path(self) -> Path:
        return self._path

    def initialize(self) -> bool:
        """Open the database and create the schema. Never raises."""
        if not self._enabled:
            logger.info("SQLite persistence is disabled by configuration.")
            return False

        try:
            self._path.parent.mkdir(parents=True, exist_ok=True)
            connection = sqlite3.connect(
                str(self._path), check_same_thread=False, timeout=10.0
            )
            connection.execute("PRAGMA journal_mode=WAL;")
            connection.executescript(_SCHEMA)
            connection.commit()
            with self._lock:
                self._connection = connection
            logger.info("SQLite status store ready at %s", self._path)
            return True
        except sqlite3.Error as exc:
            self._last_error = str(exc)
            self._enabled = False
            logger.warning(
                "SQLite status store could not be initialized (%s). Continuing "
                "without persistence.",
                exc,
            )
            return False

    def close(self) -> None:
        with self._lock:
            if self._connection is not None:
                try:
                    self._connection.close()
                except sqlite3.Error:  # pragma: no cover - defensive
                    pass
                self._connection = None
        logger.debug("SQLite status store closed.")

    # ------------------------------------------------------------------
    def _execute(self, sql: str, params: tuple[Any, ...]) -> sqlite3.Cursor | None:
        with self._lock:
            if self._connection is None:
                return None
            try:
                cursor = self._connection.execute(sql, params)
                self._connection.commit()
                self._failures = 0
                return cursor
            except sqlite3.Error as exc:
                self._failures += 1
                self._last_error = str(exc)
                logger.warning("SQLite write failed (%s): %s", self._failures, exc)
                if self._failures >= 5:
                    logger.error(
                        "Disabling SQLite persistence after %s consecutive failures.",
                        self._failures,
                    )
                    self._enabled = False
                return None

    def record_connection_event(
        self, status: MT5Status, *, symbol: str | None = None
    ) -> bool:
        """Persist a connection-state transition (deduplicated)."""
        key = (
            status.state.value,
            status.mt5_initialized,
            status.terminal_connected,
            status.account_type.value,
            status.last_connection_error,
        )
        if key == self._last_event_key:
            return False

        cursor = self._execute(
            """
            INSERT INTO connection_events
                (timestamp, state, initialized, connected, account_type, symbol, error)
            VALUES (?, ?, ?, ?, ?, ?, ?)
            """,
            (
                datetime.now(timezone.utc).isoformat(),
                status.state.value,
                int(status.mt5_initialized),
                int(status.terminal_connected),
                status.account_type.value,
                symbol,
                status.last_connection_error,
            ),
        )
        if cursor is not None:
            self._last_event_key = key
            return True
        return False

    def record_quote(self, quote: Quote) -> bool:
        """Persist the latest tick snapshot."""
        cursor = self._execute(
            """
            INSERT INTO market_snapshots
                (timestamp, symbol, bid, ask, spread_points, freshness, age_seconds, received_at)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?)
            """,
            (
                datetime.now(timezone.utc).isoformat(),
                quote.symbol,
                quote.bid,
                quote.ask,
                quote.spread_points,
                quote.freshness,
                quote.age_seconds,
                quote.received_at.isoformat() if quote.received_at else None,
            ),
        )
        return cursor is not None

    # ------------------------------------------------------------------
    # Phase 2: Strategy persistence
    # ------------------------------------------------------------------
    def record_strategy_setup(self, setup_dict: dict[str, Any]) -> bool:
        """Persist a strategy setup (insert or replace)."""
        cursor = self._execute(
            """
            INSERT OR REPLACE INTO strategy_setups
                (id, symbol, timeframe, direction, state,
                 swing_high_price, swing_high_time, swing_high_time_utc,
                 swing_low_price, swing_low_time, swing_low_time_utc,
                 fib_levels_json, zone_lower, zone_upper, primary_level_price,
                 invalidation_reason, invalidation_price, invalidation_candle_time, invalidation_candle_utc,
                 confirmation_json,
                 created_at, last_evaluated_candle_time, last_evaluated_candle_utc,
                 candles_since_creation, candles_in_zone, config_json)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
            """,
            (
                setup_dict["setup_id"],
                setup_dict["symbol"],
                setup_dict["timeframe"],
                setup_dict["direction"],
                setup_dict["state"],
                setup_dict.get("swing_high_price"),
                setup_dict.get("swing_high_time"),
                setup_dict.get("swing_high_time_utc"),
                setup_dict.get("swing_low_price"),
                setup_dict.get("swing_low_time"),
                setup_dict.get("swing_low_time_utc"),
                setup_dict.get("fib_levels_json"),
                setup_dict.get("zone_lower"),
                setup_dict.get("zone_upper"),
                setup_dict.get("primary_level_price"),
                setup_dict.get("invalidation_reason"),
                setup_dict.get("invalidation_price"),
                setup_dict.get("invalidation_candle_time"),
                setup_dict.get("invalidation_candle_utc"),
                setup_dict.get("confirmation_json"),
                setup_dict["created_at"],
                setup_dict.get("last_evaluated_candle_time"),
                setup_dict.get("last_evaluated_candle_utc"),
                setup_dict.get("candles_since_creation", 0),
                setup_dict.get("candles_in_zone", 0),
                setup_dict.get("config_json"),
            ),
        )
        return cursor is not None

    def record_state_transition(self, setup_id: str, transition_dict: dict[str, Any]) -> bool:
        """Persist a state transition for a setup."""
        cursor = self._execute(
            """
            INSERT INTO strategy_state_transitions
                (setup_id, from_state, to_state, timestamp, reason, candle_time)
            VALUES (?, ?, ?, ?, ?, ?)
            """,
            (
                setup_id,
                transition_dict["from_state"],
                transition_dict["to_state"],
                transition_dict["timestamp"],
                transition_dict["reason"],
                transition_dict.get("candle_time"),
            ),
        )
        return cursor is not None

    def get_active_setups(self) -> list[dict[str, Any]]:
        """Get all non-terminal setups (for recovery after restart)."""
        with self._lock:
            if self._connection is None:
                return []
            try:
                rows = self._connection.execute(
                    """
                    SELECT id, symbol, timeframe, direction, state,
                           swing_high_price, swing_high_time, swing_high_time_utc,
                           swing_low_price, swing_low_time, swing_low_time_utc,
                           fib_levels_json, zone_lower, zone_upper, primary_level_price,
                           invalidation_reason, invalidation_price, invalidation_candle_time, invalidation_candle_utc,
                           confirmation_json,
                           created_at, last_evaluated_candle_time, last_evaluated_candle_utc,
                           candles_since_creation, candles_in_zone, config_json
                    FROM strategy_setups
                    WHERE state NOT IN ('confirmed_buy', 'confirmed_sell', 'invalidated', 'expired')
                    ORDER BY created_at DESC
                    """
                ).fetchall()
            except sqlite3.Error as exc:
                logger.warning("SQLite read failed: %s", exc)
                return []

        return [
            {
                "setup_id": row[0],
                "symbol": row[1],
                "timeframe": row[2],
                "direction": row[3],
                "state": row[4],
                "swing_high_price": row[5],
                "swing_high_time": row[6],
                "swing_high_time_utc": row[7],
                "swing_low_price": row[8],
                "swing_low_time": row[9],
                "swing_low_time_utc": row[10],
                "fib_levels_json": row[11],
                "zone_lower": row[12],
                "zone_upper": row[13],
                "primary_level_price": row[14],
                "invalidation_reason": row[15],
                "invalidation_price": row[16],
                "invalidation_candle_time": row[17],
                "invalidation_candle_utc": row[18],
                "confirmation_json": row[19],
                "created_at": row[20],
                "last_evaluated_candle_time": row[21],
                "last_evaluated_candle_utc": row[22],
                "candles_since_creation": row[23],
                "candles_in_zone": row[24],
                "config_json": row[25],
            }
            for row in rows
        ]

    def get_setup_transitions(self, setup_id: str) -> list[dict[str, Any]]:
        """Get all state transitions for a setup."""
        with self._lock:
            if self._connection is None:
                return []
            try:
                rows = self._connection.execute(
                    """
                    SELECT setup_id, from_state, to_state, timestamp, reason, candle_time
                    FROM strategy_state_transitions
                    WHERE setup_id = ?
                    ORDER BY timestamp ASC
                    """,
                    (setup_id,),
                ).fetchall()
            except sqlite3.Error as exc:
                logger.warning("SQLite read failed: %s", exc)
                return []

        return [
            {
                "setup_id": row[0],
                "from_state": row[1],
                "to_state": row[2],
                "timestamp": row[3],
                "reason": row[4],
                "candle_time": row[5],
            }
            for row in rows
        ]

    def delete_setup(self, setup_id: str) -> bool:
        """Delete a setup and its transitions (e.g., when superseded)."""
        cursor = self._execute(
            "DELETE FROM strategy_state_transitions WHERE setup_id = ?",
            (setup_id,),
        )
        cursor = self._execute(
            "DELETE FROM strategy_setups WHERE id = ?",
            (setup_id,),
        )
        return cursor is not None

    def get_recent_strategy_setups(self, limit: int = 20) -> list[dict[str, Any]]:
        """Return the last N confirmed strategy setups, ordered newest first.

        Only setups whose state is ``confirmed_buy`` or ``confirmed_sell`` are
        returned. Pending, unconfirmed, rejected, invalidated-before-confirmation
        and expired setups are excluded. The confirmation filter is applied in
        the SQL query *before* the LIMIT clause, so the endpoint never returns
        fewer than ``limit`` records because unconfirmed rows were filtered out.

        Setups are ordered by the authoritative confirmation timestamp (the moment
        the setup transitioned from ``waiting_for_confirmation`` to
        ``confirmed_buy``/``confirmed_sell`` in ``strategy_state_transitions``),
        with the setup id as a stable unique tie-breaker when timestamps match.
        """
        with self._lock:
            if self._connection is None:
                return []
            try:
                rows = self._connection.execute(
                    """
                    SELECT
                        id, symbol, timeframe, direction, state,
                        swing_high_price, swing_high_time, swing_high_time_utc,
                        swing_low_price, swing_low_time, swing_low_time_utc,
                        fib_levels_json, zone_lower, zone_upper, primary_level_price,
                        invalidation_reason, invalidation_price, invalidation_candle_time, invalidation_candle_utc,
                        confirmation_json,
                        created_at, last_evaluated_candle_time, last_evaluated_candle_utc,
                        candles_since_creation, candles_in_zone, config_json,
                        (
                            SELECT MAX(t.timestamp)
                            FROM strategy_state_transitions t
                            WHERE t.setup_id = strategy_setups.id
                              AND t.from_state = 'waiting_for_confirmation'
                              AND t.to_state IN ('confirmed_buy', 'confirmed_sell')
                        ) AS confirmation_timestamp
                    FROM strategy_setups
                    WHERE state IN ('confirmed_buy', 'confirmed_sell')
                    ORDER BY confirmation_timestamp DESC, created_at DESC, rowid DESC, id DESC
                    LIMIT ?
                    """,
                    (int(limit),),
                ).fetchall()
            except sqlite3.Error:
                return []

        return [
            {
                "setup_id": row[0],
                "symbol": row[1],
                "timeframe": row[2],
                "direction": row[3],
                "state": row[4],
                "swing_high_price": row[5],
                "swing_high_time": row[6],
                "swing_high_time_utc": row[7],
                "swing_low_price": row[8],
                "swing_low_time": row[9],
                "swing_low_time_utc": row[10],
                "fib_levels_json": row[11],
                "zone_lower": row[12],
                "zone_upper": row[13],
                "primary_level_price": row[14],
                "invalidation_reason": row[15],
                "invalidation_price": row[16],
                "invalidation_candle_time": row[17],
                "invalidation_candle_utc": row[18],
                "confirmation_json": row[19],
                "created_at": row[20],
                "last_evaluated_candle_time": row[21],
                "last_evaluated_candle_utc": row[22],
                "candles_since_creation": row[23],
                "candles_in_zone": row[24],
                "config_json": row[25],
                "confirmation_timestamp": row[26],
            }
            for row in rows
        ]

    # ------------------------------------------------------------------
    def recent_connection_events(self, limit: int = 10) -> list[dict[str, Any]]:
        with self._lock:
            if self._connection is None:
                return []
            try:
                rows = self._connection.execute(
                    """
                    SELECT timestamp, state, initialized, connected, account_type, symbol, error
                    FROM connection_events
                    ORDER BY id DESC
                    LIMIT ?
                    """,
                    (int(limit),),
                ).fetchall()
            except sqlite3.Error as exc:  # pragma: no cover - defensive
                logger.warning("SQLite read failed: %s", exc)
                return []

        return [
            {
                "timestamp": row[0],
                "state": row[1],
                "initialized": bool(row[2]),
                "connected": bool(row[3]),
                "account_type": row[4],
                "symbol": row[5],
                "error": row[6],
            }
            for row in rows
        ]

    def recent_errors(self, limit: int = 10) -> list[dict[str, Any]]:
        """Most recent connection events that carried an error message."""
        return [
            event
            for event in self.recent_connection_events(limit * 5)
            if event.get("error")
        ][:limit]

    def counts(self) -> tuple[int, int]:
        with self._lock:
            if self._connection is None:
                return (0, 0)
            try:
                events = self._connection.execute(
                    "SELECT COUNT(*) FROM connection_events"
                ).fetchone()[0]
                snapshots = self._connection.execute(
                    "SELECT COUNT(*) FROM market_snapshots"
                ).fetchone()[0]
            except sqlite3.Error:  # pragma: no cover - defensive
                return (0, 0)
        return (int(events), int(snapshots))

    def strategy_counts(self) -> tuple[int, int]:
        """Return (active_setups, total_transitions)."""
        with self._lock:
            if self._connection is None:
                return (0, 0)
            try:
                setups = self._connection.execute(
                    "SELECT COUNT(*) FROM strategy_setups WHERE state NOT IN ('confirmed_buy', 'confirmed_sell', 'invalidated', 'expired')"
                ).fetchone()[0]
                transitions = self._connection.execute(
                    "SELECT COUNT(*) FROM strategy_state_transitions"
                ).fetchone()[0]
            except sqlite3.Error:
                return (0, 0)
        return (int(setups), int(transitions))

    def stats(self) -> StoreStats:
        events, snapshots = self.counts()
        active_setups, total_transitions = self.strategy_counts()
        return StoreStats(
            enabled=self.enabled,
            path=str(self._path) if self._enabled else None,
            connection_events=events,
            market_snapshots=snapshots,
            last_error=self._last_error,
            active_strategy_setups=active_setups,
            strategy_transitions=total_transitions,
        )

    # ==================================================================
    # Phase 4: execution records and risk state (strict writes)
    #
    # Unlike the telemetry writers above - which are deliberately
    # failure-tolerant so a database hiccup never stops market monitoring -
    # these methods RAISE when the durable record cannot be written. Execution
    # treats "cannot persist" as "cannot trade" (fail closed).
    # ==================================================================
    _EXECUTION_COLUMNS = (
        "id", "idempotency_key", "setup_id", "symbol", "timeframe", "direction",
        "source", "signal_time_utc", "confirmation_time_utc", "config_fingerprint",
        "account_login_masked", "account_server", "requested_volume", "actual_volume",
        "entry_price", "stop_loss", "take_profit", "risk_budget", "estimated_loss",
        "assessment_json", "state", "stage", "broker_retcode", "broker_order_id",
        "broker_deal_id", "position_id", "fill_price", "error_code", "error_message",
        "reconciliation", "created_at", "updated_at",
    )

    _RISK_STATE_COLUMNS = (
        "key", "risk_date", "baseline_equity", "baseline_balance",
        "high_water_equity", "lockout_reason", "lockout_at",
        "consecutive_losses", "last_reconciled_at", "updated_at",
    )

    def _execute_strict(self, sql: str, params: tuple[Any, ...]) -> sqlite3.Cursor:
        """Execute a required write; raise instead of swallowing failures."""
        with self._lock:
            if self._connection is None:
                raise StoreWriteError(
                    "Execution persistence is unavailable (database not open)."
                )
            try:
                cursor = self._connection.execute(sql, params)
                self._connection.commit()
                self._failures = 0
                return cursor
            except sqlite3.IntegrityError as exc:
                raise StoreConflictError(str(exc)) from exc
            except sqlite3.Error as exc:
                self._failures += 1
                self._last_error = str(exc)
                logger.error("Execution write failed: %s", exc)
                raise StoreWriteError(str(exc)) from exc

    def record_execution(self, row: dict[str, Any]) -> None:
        """Persist a new execution record (idempotency key must be unique)."""
        columns = self._EXECUTION_COLUMNS
        missing = [c for c in columns if c not in row]
        if missing:
            raise StoreWriteError(f"Execution row is missing columns: {missing}")
        placeholders = ", ".join("?" for _ in columns)
        self._execute_strict(
            f"INSERT INTO executions ({', '.join(columns)}) VALUES ({placeholders})",
            tuple(row[c] for c in columns),
        )

    def update_execution(self, execution_id: str, updates: dict[str, Any]) -> None:
        """Update an existing execution record; unknown ids raise."""
        if not updates:
            return
        unknown = [c for c in updates if c not in self._EXECUTION_COLUMNS]
        if unknown:
            raise StoreWriteError(f"Unknown execution columns: {unknown}")
        assignments = ", ".join(f"{c} = ?" for c in updates)
        cursor = self._execute_strict(
            f"UPDATE executions SET {assignments} WHERE id = ?",
            (*tuple(updates[c] for c in updates), execution_id),
        )
        if cursor.rowcount == 0:
            raise StoreWriteError(
                f"Execution {execution_id!r} does not exist; refusing to pretend "
                "a record was updated."
            )

    def _read_execution_rows(self, sql: str, params: tuple[Any, ...]) -> list[dict[str, Any]]:
        with self._lock:
            if self._connection is None:
                return []
            try:
                rows = self._connection.execute(sql, params).fetchall()
            except sqlite3.Error as exc:
                logger.warning("Execution read failed: %s", exc)
                return []
        return [dict(zip(self._EXECUTION_COLUMNS, row)) for row in rows]

    def get_execution(self, execution_id: str) -> dict[str, Any] | None:
        rows = self._read_execution_rows(
            f"SELECT {', '.join(self._EXECUTION_COLUMNS)} FROM executions WHERE id = ?",
            (execution_id,),
        )
        return rows[0] if rows else None

    def get_execution_by_key(self, idempotency_key: str) -> dict[str, Any] | None:
        rows = self._read_execution_rows(
            f"SELECT {', '.join(self._EXECUTION_COLUMNS)} FROM executions "
            "WHERE idempotency_key = ?",
            (idempotency_key,),
        )
        return rows[0] if rows else None

    def list_executions(self, limit: int = 50) -> list[dict[str, Any]]:
        return self._read_execution_rows(
            f"SELECT {', '.join(self._EXECUTION_COLUMNS)} FROM executions "
            "ORDER BY created_at DESC LIMIT ?",
            (int(limit),),
        )

    def count_unresolved_executions(self) -> int:
        """Submissions whose outcome is not yet established (fail closed)."""
        with self._lock:
            if self._connection is None:
                return 0
            try:
                row = self._connection.execute(
                    "SELECT COUNT(*) FROM executions WHERE state IN "
                    "('submitting', 'unknown_outcome', 'reconciling')"
                ).fetchone()
            except sqlite3.Error as exc:  # pragma: no cover - defensive
                logger.warning("Unresolved-execution count failed: %s", exc)
                return 0
        return int(row[0]) if row else 0

    def get_execution_risk_state(self, key: str = "global") -> dict[str, Any] | None:
        with self._lock:
            if self._connection is None:
                return None
            try:
                row = self._connection.execute(
                    f"SELECT {', '.join(self._RISK_STATE_COLUMNS)} "
                    "FROM execution_risk_state WHERE key = ?",
                    (key,),
                ).fetchone()
            except sqlite3.Error as exc:
                logger.warning("Risk-state read failed: %s", exc)
                return None
        return dict(zip(self._RISK_STATE_COLUMNS, row)) if row else None

    def save_execution_risk_state(self, row: dict[str, Any]) -> None:
        """Persist the risk baseline/lockout row (INSERT OR REPLACE)."""
        columns = self._RISK_STATE_COLUMNS
        missing = [c for c in columns if c not in row]
        if missing:
            raise StoreWriteError(f"Risk-state row is missing columns: {missing}")
        placeholders = ", ".join("?" for _ in columns)
        self._execute_strict(
            f"INSERT OR REPLACE INTO execution_risk_state "
            f"({', '.join(columns)}) VALUES ({placeholders})",
            tuple(row[c] for c in columns),
        )

    # ==================================================================
    # Forward (shadow) validation observations (read-only, fail-tolerant)
    #
    # These writers are deliberately failure-tolerant like the telemetry
    # writers: a database hiccup must never break the strategy engine's live
    # evaluation loop. Duplicate prevention is enforced by the UNIQUE
    # (setup_id, scenario) constraint, not by the caller.
    # ==================================================================
    _SHADOW_COLUMNS = (
        "id", "setup_id", "scenario", "source", "symbol", "timeframe",
        "direction", "confirmation_candle_time", "confirmation_time_utc",
        "confirmation_time_ist", "proposed_entry", "stop_loss", "target",
        "extension_ratio", "fib_extension_json", "status", "hit_candle_time",
        "hit_time_utc", "hit_time_ist", "hit_price", "holding_candles",
        "last_evaluated_candle_time", "outcome_basis", "entry_assumption",
        "measured_json", "assumptions_json", "gross_points", "net_points",
        "cost_points", "data_note", "created_at", "created_at_ist",
        "updated_at", "updated_at_ist",
    )

    def record_shadow_observation(self, row: dict[str, Any]) -> bool:
        """Insert one observation, ignoring an existing (setup_id, scenario).

        Returns True when a new row was written, False when the observation was
        already present (a duplicate is never reprocessed) or the write failed.
        """
        columns = self._SHADOW_COLUMNS
        missing = [c for c in columns if c not in row]
        if missing:
            logger.warning("Shadow observation is missing columns: %s", missing)
            return False
        placeholders = ", ".join("?" for _ in columns)
        cursor = self._execute(
            f"INSERT OR IGNORE INTO shadow_observations "
            f"({', '.join(columns)}) VALUES ({placeholders})",
            tuple(row[c] for c in columns),
        )
        return cursor is not None and cursor.rowcount > 0

    def update_shadow_observation(
        self, observation_id: str, updates: dict[str, Any]
    ) -> bool:
        """Update an observation's mutable outcome fields. Missing ids are a no-op."""
        if not updates:
            return False
        unknown = [c for c in updates if c not in self._SHADOW_COLUMNS]
        if unknown:
            logger.warning("Unknown shadow columns in update: %s", unknown)
            return False
        assignments = ", ".join(f"{c} = ?" for c in updates)
        cursor = self._execute(
            f"UPDATE shadow_observations SET {assignments} WHERE id = ?",
            (*tuple(updates[c] for c in updates), observation_id),
        )
        return cursor is not None and cursor.rowcount > 0

    def _read_shadow_rows(
        self, sql: str, params: tuple[Any, ...]
    ) -> list[dict[str, Any]]:
        with self._lock:
            if self._connection is None:
                return []
            try:
                rows = self._connection.execute(sql, params).fetchall()
            except sqlite3.Error as exc:
                logger.warning("Shadow observation read failed: %s", exc)
                return []
        return [dict(zip(self._SHADOW_COLUMNS, row)) for row in rows]

    def get_shadow_observation_keys(
        self, *, source: str | None = None
    ) -> set[tuple[str, str]]:
        """The (setup_id, scenario) pairs already recorded (restart dedup guard).

        ``source`` optionally restricts the keys to one producer so the live
        Fibonacci shadow and the research forward validators never dedup against
        each other.
        """
        with self._lock:
            if self._connection is None:
                return set()
            where = "WHERE source = ?" if source else ""
            params: tuple[Any, ...] = (source,) if source else ()
            try:
                rows = self._connection.execute(
                    f"SELECT setup_id, scenario FROM shadow_observations {where}",
                    params,
                ).fetchall()
            except sqlite3.Error as exc:  # pragma: no cover - defensive
                logger.warning("Shadow key read failed: %s", exc)
                return set()
        return {(str(row[0]), str(row[1])) for row in rows}

    def list_shadow_observations(
        self,
        limit: int = 200,
        *,
        scenario: str | None = None,
        timeframe: str | None = None,
        status: str | None = None,
        source: str | None = None,
    ) -> list[dict[str, Any]]:
        clauses: list[str] = []
        params: list[Any] = []
        if source:
            clauses.append("source = ?")
            params.append(source)
        if scenario:
            clauses.append("scenario = ?")
            params.append(scenario)
        if timeframe:
            clauses.append("timeframe = ?")
            params.append(timeframe)
        if status:
            clauses.append("status = ?")
            params.append(status)
        where = f"WHERE {' AND '.join(clauses)}" if clauses else ""
        params.append(int(limit))
        return self._read_shadow_rows(
            f"SELECT {', '.join(self._SHADOW_COLUMNS)} FROM shadow_observations "
            f"{where} ORDER BY created_at DESC, id DESC LIMIT ?",
            tuple(params),
        )

    def open_shadow_observations(self, *, source: str | None = None) -> list[dict[str, Any]]:
        """Observations that can still be advanced by newer candles."""
        where = "status = 'still_open'"
        params: tuple[Any, ...] = ()
        if source:
            where += " AND source = ?"
            params = (source,)
        return self._read_shadow_rows(
            f"SELECT {', '.join(self._SHADOW_COLUMNS)} FROM shadow_observations "
            f"WHERE {where} ORDER BY created_at ASC",
            params,
        )

    def shadow_status_counts(self) -> dict[str, int]:
        with self._lock:
            if self._connection is None:
                return {}
            try:
                rows = self._connection.execute(
                    "SELECT status, COUNT(*) FROM shadow_observations GROUP BY status"
                ).fetchall()
            except sqlite3.Error as exc:  # pragma: no cover - defensive
                logger.warning("Shadow count failed: %s", exc)
                return {}
        return {str(status): int(count) for status, count in rows}

    def shadow_scenario_counts(self) -> dict[str, int]:
        with self._lock:
            if self._connection is None:
                return {}
            try:
                rows = self._connection.execute(
                    "SELECT scenario, COUNT(*) FROM shadow_observations GROUP BY scenario"
                ).fetchall()
            except sqlite3.Error as exc:  # pragma: no cover - defensive
                logger.warning("Shadow scenario count failed: %s", exc)
                return {}
        return {str(scenario): int(count) for scenario, count in rows}
