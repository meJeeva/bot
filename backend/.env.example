# ==============================================================================
# MT5 market data plus optional automatic trading
# ==============================================================================

# --- Application --------------------------------------------------------------
APP_NAME=MT5 Market Data
APP_VERSION=0.1.0
APP_ENV=development
APP_READ_ONLY=true
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=standard
ALLOWED_ORIGINS=http://localhost:5173

# --- MetaTrader 5 connection --------------------------------------------------
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=
MT5_TIMEOUT_MS=60000

# --- Polling and freshness ----------------------------------------------------
POLL_INTERVAL_MS=1000
STALE_TICK_THRESHOLD_SECONDS=20
RECONNECT_INITIAL_DELAY_SECONDS=2
RECONNECT_MAX_DELAY_SECONDS=60
RECONNECT_MAX_ATTEMPTS=0
SELECT_SYMBOL_IN_MARKET_WATCH=true

# --- WebSocket ----------------------------------------------------------------
WS_MAX_QUEUE=8
WS_PUSH_INTERVAL_MS=500
WS_HEARTBEAT_SECONDS=30

# --- Candle data --------------------------------------------------------------
CANDLE_LIMIT=300
MAX_CANDLE_LIMIT=5000
CANDLE_REFRESH_SECONDS=300

# --- Persistence --------------------------------------------------------------
DATABASE_ENABLED=true
DATABASE_PATH=

# --- Credential display -------------------------------------------------------
EXPOSE_ACCOUNT_LOGIN=false

# --- Automatic trading: common ------------------------------------------------
AUTO_TRADE_MAGIC_NUMBER=9001
AUTO_TRADE_MAX_DAILY_LOSS=100
AUTO_TRADE_MAX_CYCLES=1000
AUTO_TRADE_STOP_POLICY=close
AUTO_TRADE_MAX_RETRIES=3
AUTO_TRADE_EXIT_BUFFER_SECONDS=2

TRADING_MODE=demo
AUTO_TRADE_DEMO_AUTHORIZED=true

# --- Dynamic break-even -------------------------------------------------------
BE_MODE=atr
BE_ATR_PERIOD=14
BE_ATR_MULTIPLIER=0.6
BE_MIN_SPREAD_MULTIPLIER=2.0
BE_COST_BUFFER_PER_LOT=0.0

# --- Instrument profile selection --------------------------------------------
AUTO_TRADE_PROFILE=XAUUSD

# --- XAUUSD profile ----------------------------------------------------------
XAUUSD_MT5_SYMBOL=XAUUSD
XAUUSD_MT5_SYMBOL_CANDIDATES=XAUUSD,XAUUSD.,XAUUSDm,XAUUSD.c,#XAUUSD
XAUUSD_TIMEFRAME=M1
XAUUSD_ENTRY_OFFSET=1.00
XAUUSD_BREAK_EVEN_OFFSET=0.40
XAUUSD_TRAILING_DISTANCE=0.40
XAUUSD_LOT_SIZE=0.01
XAUUSD_MAX_SPREAD_POINTS=100
XAUUSD_MAX_ENTRY_DEVIATION_POINTS=20

# --- BTCUSD profile ----------------------------------------------------------
# AUTO_TRADE_PROFILE=BTCUSD
# BTCUSD_MT5_SYMBOL=BTCUSD
# BTCUSD_MT5_SYMBOL_CANDIDATES=BTCUSD,BTCUSDm,BTCUSD.c,#BTCUSD,BTCUSD.
# BTCUSD_TIMEFRAME=M1
# BTCUSD_ENTRY_OFFSET=15.0
# BTCUSD_BREAK_EVEN_OFFSET=4.0
# BTCUSD_TRAILING_DISTANCE=4.0
# BTCUSD_LOT_SIZE=1.0
# BTCUSD_MAX_SPREAD_POINTS=100
# BTCUSD_MAX_ENTRY_DEVIATION_POINTS=20

# --- Performance reporting ----------------------------------------------------
REPORT_TIMEZONE=Asia/Kolkata
PERFORMANCE_MAX_HISTORY_DAYS=92
PERFORMANCE_CACHE_SECONDS=10