# ==============================================================================
# Market data only - no trading
# ==============================================================================
# This application connects to a MetaTrader 5 terminal, reads market data
# and serves it to the dashboard. It cannot place, modify or close an order.
# There is no execution, strategy or backtest configuration to set.

# --- Application --------------------------------------------------------------
APP_NAME=MT5 Market Data
APP_VERSION=0.1.0
APP_ENV=development
# Safety switch: must remain True.
APP_READ_ONLY=true
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=standard
# Comma-separated list of allowed CORS origins.
ALLOWED_ORIGINS=http://localhost:5173

# --- MetaTrader 5 connection --------------------------------------------------
# Preferred: leave the credentials empty and let the application attach to the
# MetaTrader 5 terminal that is already running and logged in.
MT5_SYMBOL=XAUUSD
MT5_SYMBOL_CANDIDATES=XAUUSD,XAUUSD.,XAUUSDm,XAUUSD.c,#XAUUSD
MT5_SYMBOL_STRICT=false
# Optional unattended login. All three must be supplied together, and the
# password is never logged or exposed over HTTP.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Optional path to terminal64.exe (or its install directory). Empty means the
# application attaches to the running terminal, then scans the usual install roots.
MT5_TERMINAL_PATH=
MT5_TIMEOUT_MS=60000

# --- Polling and freshness ----------------------------------------------------
POLL_INTERVAL_MS=1000
# A tick older than this is reported as stale, never as live.
STALE_TICK_THRESHOLD_SECONDS=20
RECONNECT_INITIAL_DELAY_SECONDS=2
RECONNECT_MAX_DELAY_SECONDS=60
# 0 means retry forever.
RECONNECT_MAX_ATTEMPTS=0
# Add the resolved symbol to Market Watch so ticks are available.
SELECT_SYMBOL_IN_MARKET_WATCH=true

# --- WebSocket ----------------------------------------------------------------
WS_MAX_QUEUE=8
WS_PUSH_INTERVAL_MS=500
WS_HEARTBEAT_SECONDS=30

# --- Candle data --------------------------------------------------------------
CANDLE_LIMIT=300
MAX_CANDLE_LIMIT=5000
# Seconds between candle history refreshes.
CANDLE_REFRESH_SECONDS=300

# --- Persistence --------------------------------------------------------------
DATABASE_ENABLED=true
# Empty uses backend/data/mt5_status.db. Set to use another SQLite file.
DATABASE_PATH=

# --- Credential display -------------------------------------------------------
# Expose the account login instead of masking it. Leave false on shared machines.
EXPOSE_ACCOUNT_LOGIN=false
