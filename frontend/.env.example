# ---------------------------------------------------------------------------
# Fibonacci MT5 Bot - Phase 1 frontend configuration
#
# Copy to `frontend/.env` and adjust. Only VITE_-prefixed variables are
# exposed to the browser bundle, so never put secrets in this file.
# ---------------------------------------------------------------------------

# Base URL of the Python backend REST API.
# Leave EMPTY to use the Vite dev-server proxy (recommended in development):
# requests to /api are then forwarded to the backend configured in
# vite.config.ts, and the browser never needs CORS.
VITE_API_BASE_URL=

# WebSocket URL for the live market-data stream.
# Leave EMPTY to derive it from the current page origin through the proxy.
VITE_WS_URL=

# How often the dashboard re-fetches the selected timeframe's history (ms).
VITE_HISTORY_REFRESH_MS=30000
